# ──────────────────────────────────────────────
# OmniMind Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to version control, and keep this file's values EMPTY —
# it is committed, so anything filled in here is published.
# ──────────────────────────────────────────────

# ── Phase 1: Foundation ──────────────────────

# Postgres
DATABASE_URL=postgresql+asyncpg://omnimind:omnimind@localhost:5432/omnimind

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=omnimind-documents
MINIO_SECURE=false

# development | staging | production.
# Anything other than "development" makes the app refuse to start with the default
# JWT key or with the demo-user fallback enabled.
ENVIRONMENT=development

# Browser origins allowed to call the API, comma-separated. Must list the real
# frontend domain in production or every browser request is blocked by CORS.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Auth
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Anyone holding this key can mint a valid token for any account.
JWT_SECRET_KEY=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Local demo convenience. When true, a request with a missing or invalid token is
# served as the built-in demo user instead of being rejected with 401 — which turns
# OFF authentication for every protected route and collapses tenant isolation.
# Leave false anywhere that is not your own machine.
ALLOW_DEMO_USER_FALLBACK=false

# ── Phase 2+: External services (not needed yet) ──

# Pinecone (managed vector DB — no local container)
PINECONE_API_KEY=
PINECONE_INDEX_HOST=

# OpenRouter (LLM gateway)
OPENROUTER_API_KEY=

# Cohere (Primary Reranker — falls back to local FlashRank)
COHERE_API_KEY=

# Langfuse (observability)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Tavily AI Search (Web search for knowledge gap augmentation — free tier at tavily.com)
# If left empty, automatically falls back to DuckDuckGo search.
TAVILY_API_KEY=

# ── Voice mode (Gemini Live API — see docs/ADR/003-voice-mode.md) ──
# Reuses GEMINI_API_KEY; no separate credential. Set VOICE_ENABLED=false to
# take the /voice/stream WebSocket offline without redeploying.
VOICE_ENABLED=true
VOICE_LIVE_MODEL=gemini-3.1-flash-live-preview
VOICE_NAME=Puck
# Relevance floor for the pre-speech evidence gate. Raise it to make voice more
# willing to say "I couldn't find that"; lower it to make voice answer more often
# on thin evidence. This is the quality/coverage dial for spoken answers.
VOICE_EVIDENCE_FLOOR=0.35
